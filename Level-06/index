<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>SIMON基礎造型實驗室-LEVEL6</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { background: #080808; color: #eee; font-family: 'PingFang TC', sans-serif; overflow: hidden; height: 100dvh; width: 100dvw; }
        #canvas-container { position: fixed; inset: 0; z-index: 0; }

        /* ══ DESKTOP ══ */
        #ui-desktop {
            display: none; position: absolute; top: 20px; left: 20px;
            background: rgba(15,15,15,0.95); padding: 25px; border-radius: 12px;
            width: clamp(260px, 22vw, 360px); border: 1px solid #333; z-index: 100;
            backdrop-filter: blur(10px); box-shadow: 0 10px 40px rgba(0,0,0,0.6);
            max-height: 90vh; overflow-y: auto;
        }
        #ui-desktop::-webkit-scrollbar { width: 4px; }
        #ui-desktop::-webkit-scrollbar-thumb { background: #333; border-radius: 2px; }

        @media (min-width: 769px) and (hover: hover) and (pointer: fine) {
            #ui-desktop { display: block; }
            #ui-mobile   { display: none !important; }
        }

        /* Desktop 共用樣式 */
        #ui-desktop .cg { margin-bottom: 16px; }
        #ui-desktop label { display: block; font-size: 11px; margin-bottom: 8px; color: #aaa; text-transform: uppercase; letter-spacing: 1px; }
        #ui-desktop input[type=range] { width: 100%; cursor: pointer; -webkit-appearance: none; background: transparent; }
        #ui-desktop input[type=range]::-webkit-slider-runnable-track { background: #333; height: 4px; border-radius: 2px; }
        #ui-desktop input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 14px; height: 14px; border-radius: 50%; margin-top: -5px; transition: transform .1s; background: #ffaa00; }
        #ui-desktop input[type=range]::-webkit-slider-thumb:hover { transform: scale(1.2); }
        #ui-desktop .s1::-webkit-slider-thumb { background: #ffdd00; box-shadow: 0 0 8px rgba(255,221,0,.5); }
        #ui-desktop .s2::-webkit-slider-thumb { background: #ff6622; box-shadow: 0 0 8px rgba(255,102,34,.5); }
        #ui-desktop .v  { float: right; font-weight: bold; font-family: monospace; font-size: 14px; }
        #ui-desktop .pv { color: #ffaa00; }
        #ui-desktop .v1 { color: #ffdd00; }
        #ui-desktop .v2 { color: #ff6622; }
        #ui-desktop h3  { margin: 0 0 5px; font-size: 18px; letter-spacing: 1px; color: #fff; }
        #ui-desktop .desc { font-size: 12px; color: #666; margin-bottom: 20px; font-weight: 300; }
        #ui-desktop .divider { height: 1px; background: #222; margin: 18px 0; }
        #ui-desktop .stage-box { border-left: 3px solid #333; padding: 12px 0 12px 15px; margin-top: 18px; background: rgba(255,255,255,.02); border-radius: 0 6px 6px 0; }
        #ui-desktop .stage-box.d1 { border-left-color: #ffdd00; background: rgba(255,221,0,.03); }
        #ui-desktop .stage-box.d2 { border-left-color: #ff6622; background: rgba(255,102,34,.04); }
        #ui-desktop .stage-title { font-size: 10px; color: #888; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 2px; }
        #ui-desktop .back { display: flex; align-items: center; gap: 8px; text-decoration: none; color: #00ffcc; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 20px; padding: 10px 14px; border: 1px solid rgba(0,255,204,.3); border-radius: 8px; background: rgba(0,255,204,.06); transition: background .2s, border-color .2s; }
        #ui-desktop .back:hover { background: rgba(0,255,204,.14); border-color: rgba(0,255,204,.7); }

        /* 截面示意圖 */
        #prev-wrap { border-radius: 8px; border: 1px solid #2a2a2a; background: rgba(255,255,255,.02); margin-bottom: 18px; overflow: hidden; }
        #prev { width: 100%; height: 160px; display: block; }

        /* 角度 + AB readout */
        .ang-box { text-align: center; padding: 14px; background: rgba(0,255,204,.05); border-radius: 8px; border: 1px solid rgba(0,255,204,.15); margin-top: 18px; }
        .ang-lbl { font-size: 9px; color: #555; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 4px; }
        .ang-val { font-size: 30px; font-weight: bold; color: #00ffcc; font-family: monospace; }
        .ab-row { display: flex; gap: 10px; margin-top: 10px; }
        .ab-item { flex: 1; text-align: center; padding: 6px 0; border-radius: 4px; background: rgba(255,255,255,.04); border: 1px solid #2a2a2a; }
        .ab-lbl { font-size: 9px; color: #555; letter-spacing: 1px; text-transform: uppercase; }
        .ab-d1  { color: #ffdd00; font-size: 13px; font-weight: bold; font-family: monospace; }
        .ab-d2  { color: #ff6622; font-size: 13px; font-weight: bold; font-family: monospace; }
        .hint { font-size: 12px; line-height: 1.8; color: #999; border-top: 1px solid #333; padding-top: 18px; margin-top: 16px; }
        .hint b { color: #fff; }

        /* ══ MOBILE ══ */
        #ui-mobile { position: fixed; bottom: 0; left: 0; right: 0; z-index: 200; background: rgba(10,10,10,0.96); border-top: 1px solid #222; border-radius: 16px 16px 0 0; backdrop-filter: blur(24px); padding: 0 18px; padding-bottom: env(safe-area-inset-bottom, 0px); }
        .drag-handle { width: 32px; height: 4px; background: #2a2a2a; border-radius: 2px; margin: 10px auto 0; }
        .mobile-header { display: flex; align-items: center; gap: 10px; padding: 10px 0; }
        .back-btn-mobile { display: flex; align-items: center; justify-content: center; width: 30px; height: 30px; border: 1px solid rgba(0,255,204,0.25); border-radius: 7px; background: rgba(0,255,204,0.06); color: #00ffcc; font-size: 15px; text-decoration: none; flex-shrink: 0; -webkit-tap-highlight-color: transparent; }
        .mobile-title-block { flex: 1; min-width: 0; }
        .mobile-level-tag { font-size: 9px; font-family: monospace; color: #00ffcc; letter-spacing: 2px; opacity: 0.6; display: block; margin-bottom: 1px; }
        .mobile-title { font-size: 12px; font-weight: 600; color: #ccc; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .hint-toggle-btn { display: flex; align-items: center; gap: 4px; background: none; border: 1px solid #2a2a2a; border-radius: 7px; color: #555; font-size: 10px; letter-spacing: 1px; padding: 5px 9px; cursor: pointer; flex-shrink: 0; -webkit-tap-highlight-color: transparent; transition: border-color 0.2s, color 0.2s; }
        .hint-toggle-btn.active { border-color: rgba(0,255,204,0.3); color: #00ffcc; }
        .hint-toggle-btn .arrow { font-size: 7px; transition: transform 0.3s; display: inline-block; }
        .hint-toggle-btn.active .arrow { transform: rotate(180deg); }

        .controls-area { padding-bottom: 14px; }
        .control-row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
        .control-row:last-child { margin-bottom: 0; }
        .control-label { font-size: 9px; text-transform: uppercase; letter-spacing: 1px; white-space: nowrap; width: 52px; flex-shrink: 0; color: #555; }
        .control-label.prop { color: #7a5a2a; }
        .control-label.d1   { color: rgba(255,221,0,0.55); }
        .control-label.d2   { color: rgba(255,102,34,0.55); }

        input[type=range] { flex: 1; -webkit-appearance: none; background: transparent; cursor: pointer; touch-action: pan-x; }
        input[type=range]::-webkit-slider-runnable-track { background: #222; height: 6px; border-radius: 3px; }
        input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 22px; height: 22px; border-radius: 50%; margin-top: -8px; }
        input.prop-slider::-webkit-slider-thumb { background: #ffaa00; box-shadow: 0 0 8px rgba(255,170,0,0.35); }
        input.s1::-webkit-slider-thumb { background: #ffdd00; box-shadow: 0 0 8px rgba(255,221,0,0.45); }
        input.s2::-webkit-slider-thumb { background: #ff6622; box-shadow: 0 0 8px rgba(255,102,34,0.45); }

        .control-value { font-size: 13px; font-weight: 700; font-family: monospace; width: 36px; text-align: right; flex-shrink: 0; }
        .control-value.prop { color: #ffaa00; }
        .control-value.d1   { color: #ffdd00; }
        .control-value.d2   { color: #ff6622; }

        /* 手機版角度顯示 */
        .mobile-angle-row {
            display: flex; align-items: center; gap: 8px;
            padding: 8px 0 14px;
            border-top: 1px solid #1a1a1a;
            margin-top: 4px;
        }
        .mobile-angle-label { font-size: 9px; color: #444; text-transform: uppercase; letter-spacing: 1px; flex: 1; }
        .mobile-angle-d1 { font-size: 11px; font-family: monospace; color: #ffdd00; }
        .mobile-angle-d2 { font-size: 11px; font-family: monospace; color: #ff6622; }
        .mobile-angle-val { font-size: 20px; font-weight: bold; font-family: monospace; color: #00ffcc; }

        .mobile-divider { height: 1px; background: #1e1e1e; margin: 8px 0; }

        .hint-area { overflow: hidden; max-height: 0; transition: max-height 0.32s cubic-bezier(0.4,0,0.2,1); }
        .hint-area.is-open { max-height: 220px; }
        .hint-inner { border-top: 1px solid #1c1c1c; padding: 10px 0 14px; font-size: 11px; line-height: 1.75; color: #5a5a5a; overflow-y: auto; max-height: 200px; }
        .hint-inner b { color: #888; }
    </style>
</head>
<body>

<div id="canvas-container"></div>

<!-- ══ DESKTOP ══ -->
<div id="ui-desktop">
    <a href="../index.html" class="back"><span>←</span> 返回課程首頁</a>
    <h3>SIMON Form Lab</h3>
    <div class="desc">LEVEL 6：Chamfer — D1（寬）與 D2（深）定義斜角截面</div>

    <div class="cg"><label>寬 (X) <span id="wV-d" class="v pv">120</span></label>
        <input type="range" id="W-d" min="40" max="300" value="120"></div>
    <div class="cg"><label>高 (Y) <span id="hV-d" class="v pv">80</span></label>
        <input type="range" id="H-d" min="40" max="300" value="80"></div>
    <div class="cg"><label>深 (Z) <span id="dV-d" class="v pv">150</span></label>
        <input type="range" id="D-d" min="40" max="300" value="150"></div>

    <div class="divider"></div>
    <div id="prev-wrap"><canvas id="prev" width="300" height="160"></canvas></div>

    <div class="stage-box d1">
        <div class="stage-title"><b>D1</b> 向心縮進距離（X / Z）</div>
        <label>水平距離 <span id="d1V-d" class="v v1">20</span></label>
        <input type="range" class="s1" id="slD1-d" min="0" max="100" step="0.5" value="20">
    </div>
    <div class="stage-box d2">
        <div class="stage-title"><b>D2</b> 下切深度（Y）</div>
        <label>垂直高度 <span id="d2V-d" class="v v2">25</span></label>
        <input type="range" class="s2" id="slD2-d" min="0" max="100" step="0.5" value="25">
    </div>

    <div class="ab-row">
        <div class="ab-item"><div class="ab-lbl">D1 水平</div><div class="ab-d1" id="d1Disp-d">20.0</div></div>
        <div class="ab-item"><div class="ab-lbl">D2 垂直</div><div class="ab-d2" id="d2Disp-d">25.0</div></div>
    </div>
    <div class="ang-box">
        <div class="ang-lbl">截面角度</div>
        <div class="ang-val" id="angDisp-d">51.3°</div>
    </div>

    <div class="hint">
        <b>教學觀察重點：</b><br>
        1. <b>D1 大 D2 小 → 角度平：</b>斜面趨向水平，頂部視覺寬廣。<br>
        2. <b>D1 小 D2 大 → 角度陡：</b>斜面接近垂直，邊緣銳利。<br>
        3. <b>交界線是兩個面的協商：</b>調整 XYZ 改變方體大小，D1/D2 改變斜角深度，兩者同時影響斜面與側面在哪裡相遇。<br>
        4. <b>面積的消長關係：</b>D1 越大頂面越小；D2 越深側面下段越小。此消彼長就是面的比例談判。
    </div>
</div>

<!-- ══ MOBILE ══ -->
<div id="ui-mobile">
    <div class="drag-handle"></div>
    <div class="mobile-header">
        <a href="../index.html" class="back-btn-mobile">←</a>
        <div class="mobile-title-block">
            <span class="mobile-level-tag">LEVEL 06</span>
            <span class="mobile-title">Chamfer — 斜角截面</span>
        </div>
        <button class="hint-toggle-btn" id="hintToggle">提示 <span class="arrow">▲</span></button>
    </div>

    <div class="controls-area">
        <!-- 比例 -->
        <div class="control-row">
            <span class="control-label prop">Width</span>
            <input type="range" class="prop-slider" id="W-m" min="40" max="300" value="120">
            <span class="control-value prop" id="wV-m">120</span>
        </div>
        <div class="control-row">
            <span class="control-label prop">Height</span>
            <input type="range" class="prop-slider" id="H-m" min="40" max="300" value="80">
            <span class="control-value prop" id="hV-m">80</span>
        </div>
        <div class="control-row">
            <span class="control-label prop">Depth</span>
            <input type="range" class="prop-slider" id="D-m" min="40" max="300" value="150">
            <span class="control-value prop" id="dV-m">150</span>
        </div>
        <div class="mobile-divider"></div>
        <!-- D1 / D2 -->
        <div class="control-row">
            <span class="control-label d1">D1 水平</span>
            <input type="range" class="s1" id="slD1-m" min="0" max="100" step="0.5" value="20">
            <span class="control-value d1" id="d1V-m">20.0</span>
        </div>
        <div class="control-row">
            <span class="control-label d2">D2 垂直</span>
            <input type="range" class="s2" id="slD2-m" min="0" max="100" step="0.5" value="25">
            <span class="control-value d2" id="d2V-m">25.0</span>
        </div>

        <!-- 角度即時顯示 -->
        <div class="mobile-angle-row">
            <span class="mobile-angle-label">截面角度</span>
            <span class="mobile-angle-d1" id="d1Mini">D1 20.0</span>
            <span style="color:#333;font-size:10px;">·</span>
            <span class="mobile-angle-d2" id="d2Mini">D2 25.0</span>
            <span style="color:#333;font-size:10px;">·</span>
            <span class="mobile-angle-val" id="angMobile">51°</span>
        </div>
    </div>

    <div class="hint-area" id="hintArea">
        <div class="hint-inner">
            1. <b>D1 大 D2 小</b> → 角度平，頂部視覺寬廣。<br>
            2. <b>D1 小 D2 大</b> → 角度陡，邊緣銳利。<br>
            3. 調整 XYZ 同時改變 D1/D2，感受交界線被推擠移動的位置。<br>
            4. D1 越大頂面越小；D2 越深側面下段越小——面的比例談判。
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>

<script>
    let scene, camera, renderer, mesh, controls;

    const mat = new THREE.MeshPhysicalMaterial({
        color: 0x99aacc,
        metalness: 0.15,
        roughness: 0.2,
        clearcoat: 1.0,
        clearcoatRoughness: 0.05
    });

    init(); animate();

    function init() {
        scene = new THREE.Scene();
        scene.background = new THREE.Color(0x0a0a0a);
        camera = new THREE.PerspectiveCamera(60, innerWidth / innerHeight, 1, 3000);
        camera.position.set(280, 220, 280);
        renderer = new THREE.WebGLRenderer({ antialias: true });
        renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
        renderer.setSize(innerWidth, innerHeight);
        document.getElementById('canvas-container').appendChild(renderer.domElement);
        controls = new THREE.OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true; controls.dampingFactor = 0.05;

        /* ── 燈光：對齊 L4 / L5 ── */
        scene.add(new THREE.AmbientLight(0x2a2a2a));
        const ml = new THREE.DirectionalLight(0xffffff, 1.2); ml.position.set(100, 200, 150); scene.add(ml);
        const fl = new THREE.DirectionalLight(0x00ffcc, 0.6); fl.position.set(-100, -50, 100); scene.add(fl);
        const rl = new THREE.DirectionalLight(0xff00cc, 0.3); rl.position.set(100, -100, -200); scene.add(rl);

        window.addEventListener('resize', () => {
            camera.aspect = innerWidth / innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(innerWidth, innerHeight);
        });

        // 綁定所有滑桿
        ['W','H','D','slD1','slD2'].forEach(name => {
            ['-d','-m'].forEach(s => {
                const el = document.getElementById(name + s);
                if (el) el.addEventListener('input', function() {
                    // 同步另一邊
                    const other = s === '-d' ? '-m' : '-d';
                    const otherEl = document.getElementById(name + other);
                    if (otherEl) otherEl.value = this.value;
                    go();
                });
            });
        });

        go();
    }

    function isMob() {
        return !window.matchMedia('(min-width:769px) and (hover:hover) and (pointer:fine)').matches;
    }

    function gv(name) {
        const s = isMob() ? '-m' : '-d';
        return parseFloat(document.getElementById(name + s).value);
    }

    function go() {
        const w = gv('W'), h = gv('H'), d = gv('D');
        const hw = w/2, hh = h/2, hd = d/2;

        const maxD1 = Math.min(hw, hd) - 0.5;
        const maxD2 = h - 0.5;

        ['-d','-m'].forEach(s => {
            document.getElementById('slD1'+s).max = maxD1.toFixed(1);
            document.getElementById('slD2'+s).max = maxD2.toFixed(1);
        });

        const d1  = Math.min(gv('slD1'), maxD1);
        const d2  = Math.min(gv('slD2'), maxD2);
        const ang = d1 > 0.1 ? Math.atan2(d2, d1) * 180 / Math.PI : 90;
        const angStr = ang.toFixed(1) + '°';

        // Desktop 顯示
        document.getElementById('wV-d').innerText     = w;
        document.getElementById('hV-d').innerText     = h;
        document.getElementById('dV-d').innerText     = d;
        document.getElementById('d1V-d').innerText    = d1.toFixed(1);
        document.getElementById('d2V-d').innerText    = d2.toFixed(1);
        document.getElementById('d1Disp-d').innerText = d1.toFixed(1);
        document.getElementById('d2Disp-d').innerText = d2.toFixed(1);
        document.getElementById('angDisp-d').innerText = angStr;

        // Mobile 顯示
        document.getElementById('wV-m').innerText  = w;
        document.getElementById('hV-m').innerText  = h;
        document.getElementById('dV-m').innerText  = d;
        document.getElementById('d1V-m').innerText = d1.toFixed(1);
        document.getElementById('d2V-m').innerText = d2.toFixed(1);
        document.getElementById('d1Mini').innerText = 'D1 ' + d1.toFixed(1);
        document.getElementById('d2Mini').innerText = 'D2 ' + d2.toFixed(1);
        document.getElementById('angMobile').innerText = Math.round(ang) + '°';

        drawPrev(d1, d2, ang);
        buildMesh(w, h, d, d1, d2);
    }

    /* ── 截面示意圖（僅桌機顯示，畫布在 desktop UI 內）── */
    function drawPrev(d1, d2, ang) {
        const cv = document.getElementById('prev');
        if (!cv) return;
        const ctx = cv.getContext('2d');
        const W = cv.width, H = cv.height;
        ctx.clearRect(0, 0, W, H);

        const gW = W * 0.55, gH = H;
        const maxRef = 80;
        const scale = Math.min((gH-28)*0.75/maxRef, (gW-28)*0.75/maxRef);
        const dv1 = Math.min(d1 * scale, gW * 0.72);
        const dv2 = Math.min(d2 * scale, gH * 0.72);
        const ox = gW / 2 + dv1 / 2;
        const oy = gH / 2 - dv2 / 2;

        ctx.setLineDash([3,4]); ctx.strokeStyle='#2a2a2a'; ctx.lineWidth=1;
        ctx.beginPath();
        ctx.moveTo(ox, oy+dv2+16); ctx.lineTo(ox, oy);
        ctx.moveTo(ox, oy); ctx.lineTo(ox-dv1-16, oy);
        ctx.stroke(); ctx.setLineDash([]);

        if (dv1 > 2) {
            ctx.strokeStyle='#ffdd00'; ctx.lineWidth=2.5;
            ctx.beginPath(); ctx.moveTo(ox,oy); ctx.lineTo(ox-dv1,oy); ctx.stroke();
            ctx.beginPath(); ctx.moveTo(ox-dv1+9,oy-5); ctx.lineTo(ox-dv1,oy); ctx.lineTo(ox-dv1+9,oy+5); ctx.stroke();
            ctx.fillStyle='#ffdd00'; ctx.font='bold 12px monospace';
            ctx.fillText('D1', ox-dv1/2-10, oy-8);
        }
        if (dv2 > 2) {
            ctx.strokeStyle='#ff6622'; ctx.lineWidth=2.5;
            ctx.beginPath(); ctx.moveTo(ox,oy); ctx.lineTo(ox,oy+dv2); ctx.stroke();
            ctx.beginPath(); ctx.moveTo(ox-5,oy+dv2-9); ctx.lineTo(ox,oy+dv2); ctx.lineTo(ox+5,oy+dv2-9); ctx.stroke();
            ctx.fillStyle='#ff6622'; ctx.font='bold 12px monospace';
            ctx.fillText('D2', ox+8, oy+dv2/2+5);
        }
        if (dv1 > 1 || dv2 > 1) {
            ctx.beginPath();
            ctx.moveTo(ox-dv1, oy); ctx.lineTo(ox, oy+dv2);
            ctx.strokeStyle='rgba(255,255,255,.85)'; ctx.lineWidth=3;
            ctx.stroke();
        }

        const rx = gW + 14;
        ctx.fillStyle='rgba(255,255,255,.85)'; ctx.font='12px monospace';
        ctx.fillText('D1 = '+d1.toFixed(1), rx, H*0.22);
        ctx.fillStyle='rgba(255,102,34,.9)'; ctx.font='12px monospace';
        ctx.fillText('D2 = '+d2.toFixed(1), rx, H*0.40);
        ctx.fillStyle='#00ffcc'; ctx.font='bold 26px monospace';
        ctx.fillText(Math.round(ang)+'°', rx, H*0.72);
    }

    /* ── 建立斜角幾何（原版演算法完整保留）── */
    function buildMesh(w, h, d, d1, d2) {
        if (mesh) { scene.remove(mesh); mesh.geometry.dispose(); }

        const hw=w/2, hh=h/2, hd=d/2;
        const bh=-hh, sh=hh-d2, th=hh, tw=hw-d1, td=hd-d1;

        if (d1 <= 0.1 || d2 <= 0.1) {
            mesh = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat);
            scene.add(mesh);
            return;
        }

        const P = [
            new THREE.Vector3(-hw, bh, -hd), new THREE.Vector3( hw, bh, -hd),
            new THREE.Vector3( hw, bh,  hd), new THREE.Vector3(-hw, bh,  hd),
            new THREE.Vector3(-hw, sh, -hd), new THREE.Vector3( hw, sh, -hd),
            new THREE.Vector3( hw, sh,  hd), new THREE.Vector3(-hw, sh,  hd),
            new THREE.Vector3(-tw, th, -td), new THREE.Vector3( tw, th, -td),
            new THREE.Vector3( tw, th,  td), new THREE.Vector3(-tw, th,  td),
        ];

        const verts = [], norms = [];

        function quad(a, b, c, dd, nx, ny, nz) {
            verts.push(
                P[a].x,P[a].y,P[a].z, P[b].x,P[b].y,P[b].z, P[c].x,P[c].y,P[c].z,
                P[a].x,P[a].y,P[a].z, P[c].x,P[c].y,P[c].z, P[dd].x,P[dd].y,P[dd].z
            );
            for (let i=0; i<6; i++) norms.push(nx, ny, nz);
        }

        const L=Math.hypot(d1,d2), nb=d1/L, na=d2/L;

        quad(0,1,2,3,   0,-1, 0);
        quad(4,5,1,0,   0, 0,-1);
        quad(5,6,2,1,   1, 0, 0);
        quad(6,7,3,2,   0, 0, 1);
        quad(7,4,0,3,  -1, 0, 0);
        quad(8,9,5,4,   0,na,-nb);
        quad(9,10,6,5,  nb,na, 0);
        quad(10,11,7,6, 0,na, nb);
        quad(11,8,4,7, -nb,na, 0);
        quad(11,10,9,8, 0, 1, 0);

        const geo = new THREE.BufferGeometry();
        geo.setAttribute('position', new THREE.Float32BufferAttribute(verts, 3));
        geo.setAttribute('normal',   new THREE.Float32BufferAttribute(norms, 3));

        mesh = new THREE.Mesh(geo, mat);

        const edgeGeo = new THREE.EdgesGeometry(geo, 15);
        const edgeMat = new THREE.LineBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.25 });
        mesh.add(new THREE.LineSegments(edgeGeo, edgeMat));

        scene.add(mesh);
    }

    function animate() { requestAnimationFrame(animate); controls.update(); renderer.render(scene, camera); }

    // 提示 toggle
    const hintToggle = document.getElementById('hintToggle');
    const hintArea   = document.getElementById('hintArea');
    hintToggle.addEventListener('click', () => {
        const open = hintArea.classList.toggle('is-open');
        hintToggle.classList.toggle('active', open);
    });
</script>
